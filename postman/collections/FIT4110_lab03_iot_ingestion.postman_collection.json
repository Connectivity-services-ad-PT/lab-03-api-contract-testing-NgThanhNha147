                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consumer smoke - AI Vision mock remains reachable dependency example",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{aiVisionMockUrl}}/detect",
              "host": ["{{aiVisionMockUrl}}"],
              "path": ["detect"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera_id\": \"CAM01\",\n  \"image_url\": \"https://example.com/frame.jpg\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consumer receives success from external provider mock', function () { pm.response.to.have.status(200); });",
                  "pm.test('Consumer can parse provider fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('detection_id');",
                  "  pm.expect(json).to.have.property('confidence');",
                  "  pm.expect(json.confidence).to.be.within(0, 1);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06_Local_only_NonFunctional",
      "item": [
        {
          "name": "POST /events/sensor - local response time threshold",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "iot-local-latency-0001" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-004\",\n  \"zoneId\": \"ZONE-D1\",\n  \"measurement\": {\n    \"sensorType\": \"HUMIDITY\",\n    \"value\": 55.2,\n    \"unit\": \"PERCENT\"\n  },\n  \"timestamp\": \"2026-05-19T03:04:00Z\",\n  \"metadata\": {}\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const env = pm.environment.get('env') || 'mock';",
                  "if (env === 'local') {",
                  "  pm.test('Local service responds under 1000ms', function () { pm.expect(pm.response.responseTime).to.be.below(1000); });",
                  "} else {",
                  "  pm.test('Skipped on mock: mock latency is not evidence of real service reliability', function () { pm.expect(true).to.eql(true); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
