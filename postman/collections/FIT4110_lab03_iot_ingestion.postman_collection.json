{
  "info": {
    "_postman_id": "fit4110-lab03-group8-iot-ingestion",
    "name": "FIT4110 Lab03 - Group 8 IoT Ingestion Contract Tests",
    "description": "Contract tests for Nguyen Thi Thanh Nha - Nhom 8/B1 - IoT Ingestion. Tests cover health, sensor event ingestion, telemetry audit, auth expectations, negative payloads, boundary values, consumer-side smoke, and local-only reliability checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const prefix = pm.environment.get('tracePrefix') || 'fit4110-lab03';",
          "pm.variables.set('traceId', prefix + '-' + Date.now());",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.get('traceId') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00_Health",
      "item": [
        {
          "name": "GET /health - service is alive",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response identifies IoT Ingestion', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status', 'ok');",
                  "  pm.expect(json).to.have.property('service', 'iot-ingestion');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "POST /events/sensor - accepts temperature event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "iot-dev-001-20260519-0001" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-001\",\n  \"zoneId\": \"ZONE-A1\",\n  \"measurement\": {\n    \"sensorType\": \"TEMPERATURE\",\n    \"value\": 31.5,\n    \"unit\": \"CELSIUS\"\n  },\n  \"timestamp\": \"2026-05-19T02:59:58Z\",\n  \"metadata\": {}\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', function () { pm.response.to.have.status(202); });",
                  "pm.test('Response has accepted event metadata', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('eventId');",
                  "  pm.expect(json).to.have.property('status', 'ACCEPTED');",
                  "  pm.expect(json).to.have.property('acceptedAt');",
                  "  pm.expect(json.publishedEvents).to.include('sensor.reading.created');",
                  "  pm.expect(json.publishedEvents).to.include('telemetry.ingested');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /telemetry - accepts motion telemetry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "iot-dev-002-20260519-0001" }
            ],
            "url": {
              "raw": "{{baseUrl}}/telemetry",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-002\",\n  \"zoneId\": \"ZONE-A0\",\n  \"measurement\": {\n    \"sensorType\": \"MOTION\",\n    \"detected\": true,\n    \"unit\": \"BOOLEAN\"\n  },\n  \"timestamp\": \"2026-05-19T03:00:10Z\",\n  \"metadata\": {\n    \"firmwareVersion\": \"1.4.2\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202', function () { pm.response.to.have.status(202); });",
                  "pm.test('Response has async publication list', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status', 'ACCEPTED');",
                  "  pm.expect(json.publishedEvents).to.be.an('array');",
                  "  pm.expect(json.publishedEvents.length).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /telemetry/{eventId} - returns audit detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/telemetry/0196fb3d-4ad7-7d1e-9f49-5d5148d2b101",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "0196fb3d-4ad7-7d1e-9f49-5d5148d2b101"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Audit response has normalized measurement', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('eventId');",
                  "  pm.expect(json).to.have.property('deviceId');",
                  "  pm.expect(json).to.have.property('measurement');",
                  "  pm.expect(json.measurement).to.have.property('sensorType');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /devices/{deviceId} - returns device status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/devices/IOT-DEV-001",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "IOT-DEV-001"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Device response has status fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('deviceId');",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(['ONLINE', 'OFFLINE', 'ERROR', 'MAINTENANCE']).to.include(json.status);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02_Auth",
      "item": [
        {
          "name": "POST /events/sensor - missing token is rejected on real service",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "iot-auth-missing-0001" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-001\",\n  \"zoneId\": \"ZONE-A1\",\n  \"measurement\": {\n    \"sensorType\": \"TEMPERATURE\",\n    \"value\": 31.5,\n    \"unit\": \"CELSIUS\"\n  },\n  \"timestamp\": \"2026-05-19T02:59:58Z\",\n  \"metadata\": {}\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const env = pm.environment.get('env') || 'mock';",
                  "if (env === 'mock') {",
                  "  pm.test('Skipped on mock: Prism does not enforce real auth', function () { pm.expect(true).to.eql(true); });",
                  "} else {",
                  "  pm.test('Missing token returns 401 or 403', function () { pm.expect([401, 403]).to.include(pm.response.code); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /events/sensor - invalid token is rejected on real service",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer invalid-token" },
              { "key": "Idempotency-Key", "value": "iot-auth-invalid-0001" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-001\",\n  \"zoneId\": \"ZONE-A1\",\n  \"measurement\": {\n    \"sensorType\": \"TEMPERATURE\",\n    \"value\": 31.5,\n    \"unit\": \"CELSIUS\"\n  },\n  \"timestamp\": \"2026-05-19T02:59:58Z\",\n  \"metadata\": {}\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const env = pm.environment.get('env') || 'mock';",
                  "if (env === 'mock') {",
                  "  pm.test('Skipped on mock: invalid token requires real auth middleware', function () { pm.expect(true).to.eql(true); });",
                  "} else {",
                  "  pm.test('Invalid token returns 401 or 403', function () { pm.expect([401, 403]).to.include(pm.response.code); });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03_Negative",
      "item": [
        {
          "name": "POST /events/sensor - missing deviceId returns validation error",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "iot-negative-missing-device" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zoneId\": \"ZONE-A1\",\n  \"measurement\": {\n    \"sensorType\": \"TEMPERATURE\",\n    \"value\": 31.5,\n    \"unit\": \"CELSIUS\"\n  },\n  \"timestamp\": \"2026-05-19T02:59:58Z\",\n  \"metadata\": {}\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid payload returns client error', function () { pm.expect([400, 422]).to.include(pm.response.code); });",
                  "pm.test('Error response follows Problem Details shape', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('title');",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.within(400, 599);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /events/sensor - wrong sensorType enum returns validation error",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "iot-negative-enum-0001" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-001\",\n  \"zoneId\": \"ZONE-A1\",\n  \"measurement\": {\n    \"sensorType\": \"TEMPERATURE_HOT\",\n    \"value\": 31.5,\n    \"unit\": \"CELSIUS\"\n  },\n  \"timestamp\": \"2026-05-19T02:59:58Z\",\n  \"metadata\": {}\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Wrong enum returns client error', function () { pm.expect([400, 422]).to.include(pm.response.code); });",
                  "pm.test('Error response has detail or validation status', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04_Boundary_Reliability",
      "item": [
        {
          "name": "POST /events/sensor - boundary AQI value is accepted",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "iot-boundary-aqi-0001" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-003\",\n  \"zoneId\": \"ZONE-C1\",\n  \"measurement\": {\n    \"sensorType\": \"AIR_QUALITY\",\n    \"value\": 100000,\n    \"unit\": \"AQI\"\n  },\n  \"timestamp\": \"2026-05-19T03:03:00Z\",\n  \"metadata\": {\n    \"gatewayId\": \"GW-C1-01\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Boundary max value returns accepted', function () { pm.response.to.have.status(202); });",
                  "pm.test('Boundary response still queues async events', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status', 'ACCEPTED');",
                  "  pm.expect(json.publishedEvents).to.include('telemetry.ingested');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /events/sensor - value above max is rejected",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "iot-boundary-aqi-0002" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-003\",\n  \"zoneId\": \"ZONE-C1\",\n  \"measurement\": {\n    \"sensorType\": \"AIR_QUALITY\",\n    \"value\": 100001,\n    \"unit\": \"AQI\"\n  },\n  \"timestamp\": \"2026-05-19T03:03:00Z\",\n  \"metadata\": {\n    \"gatewayId\": \"GW-C1-01\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Out-of-range value returns client error', function () { pm.expect([400, 422]).to.include(pm.response.code); });",
                  "pm.test('Boundary test checks response body', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.within(400, 599);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05_Consumer_side_Smoke",
      "item": [
        {
          "name": "Consumer smoke - Core Business receives sensor event shape",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "iot-core-smoke-0001" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/sensor",
              "host": ["{{baseUrl}}"],
              "path": ["events", "sensor"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"IOT-DEV-001\",\n  \"zoneId\": \"ZONE-A1\",\n  \"measurement\": {\n    \"sensorType\": \"TEMPERATURE\",\n    \"value\": 31.5,\n    \"unit\": \"CELSIUS\"\n  },\n  \"timestamp\": \"2026-05-19T02:59:58Z\",\n  \"metadata\": {}\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Provider mock accepts contract used by Core Business consumer', function () { pm.response.to.have.status(202); });",
                  "pm.test('Consumer can read event id and published event names', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('eventId');",
